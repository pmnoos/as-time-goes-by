# Copy this file to .env and fill in real values
# PowerShell: Copy-Item .env.example .env

# Required for contact form emails via Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender must be a verified domain/sender in your Resend account
CONTACT_FROM_EMAIL=autobiography@autobiography.live

# Inbox that should receive contact form notifications
CONTACT_TO_EMAIL=petermagner3@gmail.com

# App/session secret key used by SessionMiddleware
SECRET_KEY=replace-with-a-long-random-secret

# Optional. Defaults to local sqlite database if omitted.
# DATABASE_URL=sqlite:///./blog.db
